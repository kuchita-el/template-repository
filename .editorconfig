# EditorConfig — https://editorconfig.org
# L1 baseline: editor-level basics only. These are the single source of truth for
# whitespace/encoding; do not duplicate them in a formatter config (Prettier/Biome
# read .editorconfig). Language-specific rules belong in each project.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown uses two trailing spaces for hard line breaks — keep them.
[*.md]
trim_trailing_whitespace = false
