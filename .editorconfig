# EditorConfig — https://editorconfig.org
# L1 baseline: editor-level basics only. Keep these as the single source of truth
# for whitespace/encoding rather than duplicating them in a formatter config.
# Prettier reads .editorconfig automatically; Biome only when
# formatter.useEditorconfig is true (default: false). Language-specific rules
# belong in each project.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown uses two trailing spaces for hard line breaks — keep them.
[*.md]
trim_trailing_whitespace = false

# Makefile recipes require literal tabs; spaces break them ("missing separator").
# Tool-agnostic and widely used, so absorbed into the L1 baseline.
[{Makefile,*.mk}]
indent_style = tab
